# Скопіюйте цей файл у .env і впишіть свої паролі.

# --- Підключення застосунку ---
MONGO_HOSTS=mongo-primary:27017,mongo-secondary1:27018,mongo-secondary2:27019
MONGO_REPLICA_SET=rs0
MONGO_DB=eventhub
MONGO_AUTH_SOURCE=eventhub

# --- Користувачі ---
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=change_me_admin
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=change_me_app

# --- Шардінг---
MONGOS_HOST=localhost:27025

# --- Моніторинг ---
GRAFANA_PASSWORD=change_me_grafana

# --- MongoDB Atlas ---
# Рядок підключення: Atlas UI -> Connect -> Drivers. Розкоментуйте і впишіть свій:
# ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
